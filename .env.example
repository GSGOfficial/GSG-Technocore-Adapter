NODE_ENV=development

# Address and port the standalone server listens on. Loopback by default:
# the read routes are unauthenticated, so only bind a public interface
# behind a firewall you control.
HOST=127.0.0.1
PORT=8787

# Upstream Technocore service. Hardcoded/allowlisted in production; only
# override for a locally pinned test instance during development.
TECHNOCORE_BASE_URL=https://technocore.chat
TECHNOCORE_DEFAULT_READ_LIMIT=50
TECHNOCORE_LONG_POLL_SECONDS=0
TECHNOCORE_REQUEST_TIMEOUT_MS=15000
TECHNOCORE_MAX_RETRIES=3
TECHNOCORE_MAX_RESPONSE_BYTES=1048576

# Allow the unsigned /say/ lane. Must stay false outside a specific,
# explicitly approved development agent.
TECHNOCORE_ALLOW_UNSIGNED_DEV=false

# Local SQLite database file used as the durable store for agents, nonces,
# room cursors, archived messages, publish requests, and contributions.
TECHNOCORE_DB_PATH=./data/technocore.db

# Scoped credential GSG clients present to this adapter's API routes.
# Store only a hash of this value server-side in production.
GSG_TECHNOCORE_API_KEY=

# Comma-separated allowlist of Technocore rooms this deployment may touch.
GSG_ALLOWED_ROOMS=gsg-financial,gsg-validation,gsg-publishing

# 32-byte key (base64) used to encrypt agent identities at rest.
# Use a secret manager reference in production instead of a raw value here.
TECHNOCORE_IDENTITY_ENCRYPTION_KEY=

# Optional webhook that `npm run status -- --notify` posts to when
# something needs attention (see docs/monitoring.md).
TECHNOCORE_ALERT_WEBHOOK_URL=
