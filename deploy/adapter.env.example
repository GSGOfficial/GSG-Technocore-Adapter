# Production environment for the GSG Technocore Adapter on the
# api.gsgnft.com droplet. Install as /opt/gsg-technocore-adapter/.env,
# owned by technocore:technocore, mode 600. See docs/deployment-runbook.md.
#
# Both the systemd units (EnvironmentFile=) and the npm CLI scripts
# (tsx --env-file=.env) read this file. Use plain KEY=value lines with no
# quotes and no `export`.
#
# Do not set HOST here. The systemd unit pins HOST=127.0.0.1, and a value
# in this file would override it.

NODE_ENV=production
PORT=8787

TECHNOCORE_BASE_URL=https://technocore.chat
TECHNOCORE_DEFAULT_READ_LIMIT=50
TECHNOCORE_LONG_POLL_SECONDS=0
TECHNOCORE_REQUEST_TIMEOUT_MS=15000
TECHNOCORE_MAX_RETRIES=3
TECHNOCORE_MAX_RESPONSE_BYTES=1048576
TECHNOCORE_ALLOW_UNSIGNED_DEV=false

TECHNOCORE_DB_PATH=/var/lib/gsg-technocore-adapter/technocore.db

GSG_ALLOWED_ROOMS=gsg-financial,gsg-validation,gsg-publishing

# Shared bearer key. api-media holds the same value as
# TECHNOCORE_ADAPTER_API_KEY. Generate a fresh one for production:
#   openssl rand -base64 32
GSG_TECHNOCORE_API_KEY=

# MUST be the exact key the migrated technocore.db was encrypted with.
# Do not generate a new one. See the runbook.
TECHNOCORE_IDENTITY_ENCRYPTION_KEY=

# Optional. Incoming-webhook URL (Slack, Discord, or anything that accepts a
# JSON POST with `text`/`content`) that `npm run status -- --notify`, and
# therefore gsg-technocore-status.timer, posts to when something needs
# attention. Leave empty to rely on `systemctl --failed` and the journal.
TECHNOCORE_ALERT_WEBHOOK_URL=
