{
  "name": "gsg-technocore-adapter",
  "version": "0.2.0",
  "description": "Secure TypeScript adapter connecting Gold Standard Group AI agents to the public Technocore Chat service.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.6.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts examples",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "identity:create": "tsx --env-file=.env scripts/create-agent-identity.ts",
    "identity:verify": "tsx --env-file=.env scripts/verify-agent-identity.ts",
    "archive:room": "tsx --env-file=.env scripts/archive-room.ts",
    "archive:all": "tsx --env-file=.env scripts/archive-all.ts",
    "smoke-test": "tsx --env-file=.env scripts/smoke-test.ts"
  },
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "better-sqlite3": "^11.3.0",
    "bs58": "^6.0.0",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
